{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.pathStrict": true,
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "OpxAppearance",
    "OPX_APPEARANCE_CONFIG",
    "Open77",
    "CreateThread",
    "Wait",
    "AddEventHandler",
    "TriggerEvent",
    "RegisterNetEvent",
    "TriggerServerEvent",
    "TriggerClientEvent",
    "SetTimeout",
    "RegisterCommand",
    "GetCurrentResourceName",
    "GetResourceState",
    "GetPlayerIdentifier",
    "GetInvokingResource",
    "GetInvokingResourceGeneration",
    "source",
    "exports",
    "print",
    "json",
    "GetPlayersInBucket"
  ],
  "workspace.library": [
    "std"
  ],
  "diagnostics.disable": [
    "lowercase-global",
    "luadoc-miss-symbol",
    "unknown-doc-tag",
    "undefined-doc-name",
    "undefined-doc-param-name",
    "doc-field-no-class"
  ],
  "diagnostics.severity": {
    "undefined-global": "Error",
    "unused-local": "Warning",
    "unused-function": "Warning"
  },
  "format.enable": true,
  "format.defaultConfig": {
    "indent_style": "tab",
    "quote_style": "single"
  },
  "workspace.ignoreDir": [
    ".claude",
    "std"
  ]
}
